# HTTP(S) URL of the relay, without a trailing slash.
# Use the HTTP API URL, not the wss:// URL configured in the Foundry module.
FOUNDRY_REST_API_BASE_URL=http://localhost:3011

# Keep this secret out of Git. Grant only: clients:read, structure:read, entity:read.
FOUNDRY_REST_API_KEY=

# Optional. Omit when the API key is scoped to one Foundry world.
FOUNDRY_CLIENT_ID=
