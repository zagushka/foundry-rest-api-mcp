# HTTP(S) URL of the relay API, without a trailing slash.
# Do not use the ws:// or wss:// URL configured in the Foundry module.
# Public relay: https://foundryrestapi.com
# Standard self-hosted local relay: http://localhost:3011
FOUNDRY_REST_API_BASE_URL=http://localhost:3011

# Keep this secret out of Git. Grant only the relay scopes required by the MCP tools you use.
FOUNDRY_REST_API_KEY=

# Optional. Omit when a scoped API key is bound to one Foundry world.
FOUNDRY_CLIENT_ID=
