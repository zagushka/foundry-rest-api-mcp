{
  "name": "foundry-rest-api-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for the FoundryVTT REST API Relay",
  "type": "module",
  "bin": {
    "foundry-rest-api-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
