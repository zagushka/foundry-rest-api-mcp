{
  "name": "foundry-rest-api-mcp",
  "version": "0.3.1",
  "private": true,
  "description": "MCP server for the FoundryVTT REST API Relay",
  "license": "MIT",
  "keywords": [
    "codex",
    "foundryvtt",
    "foundry-rest-api",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zagushka/foundry-rest-api-mcp.git"
  },
  "homepage": "https://github.com/zagushka/foundry-rest-api-mcp#readme",
  "bugs": {
    "url": "https://github.com/zagushka/foundry-rest-api-mcp/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "foundry-rest-api-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && npm run build && node test/smoke.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
